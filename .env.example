# =============================================================================
# Project Overdrive — Environment Configuration (Example)
# =============================================================================
# Copy this file to .env and customize.

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=llamacpp                  # llamacpp | openvino | ollama | openai | anthropic | gemini
LLM_TEMPERATURE=0

# ── GPU Backend (llama.cpp with CUDA) ────────────────────────────────────────
GPU_MODEL_PATH=models/gpu/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
GPU_CONTEXT_SIZE=4096
GPU_N_GPU_LAYERS=-1
GPU_MAX_TOKENS=2048

# ── NPU Backend (Intel OpenVINO) ─────────────────────────────────────────────
NPU_MODEL_PATH=models/npu/
NPU_DEVICE=NPU
NPU_MAX_TOKENS=1024

# ── RAG Knowledge Base ──────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_COLLECTION_NAME=ctf_knowledge
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=30
RAG_TOP_K=5
RAG_PERSIST_DIR=data/chromadb
RAG_DATA_DIR=data/knowledge

# ── Ollama Fallback ──────────────────────────────────────────────────────────
LOCAL_MODEL_NAME=gemma4:e4b
LOCAL_API_BASE=http://localhost:11434

# ── Cloud API Keys ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Agent Configuration ──────────────────────────────────────────────────────
AGENT_CONFIG=agents.yml
MAX_AGENT_STEPS=50

# ── Guardrails ───────────────────────────────────────────────────────────────
ENABLE_GUARDRAILS=true
GUARDRAIL_MODE=block

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TRACE_TOOL_CALLS=true

# ── Legacy ───────────────────────────────────────────────────────────────────
USE_LOCAL_LLM=true
USE_GEMINI=false
